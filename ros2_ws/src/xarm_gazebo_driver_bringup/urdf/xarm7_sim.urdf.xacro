<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="xarm7_sim">
  <xacro:include filename="$(find xarm_description)/urdf/xarm_device_macro.xacro"/>

  <!-- Reuse upstream geometry, inertias, joint limits, and hardware interfaces. -->
  <xacro:xarm_device
    dof="7"
    robot_type="xarm"
    ros2_control_plugin="gazebo_ros2_control/GazeboSystem"
    load_gazebo_plugin="false"/>

  <!-- Own the namespace explicitly; the upstream plugin macro has no namespace. -->
  <gazebo>
    <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
      <robot_param>robot_description</robot_param>
      <robot_param_node>/sim/robot_state_publisher</robot_param_node>
      <parameters>$(find xarm_gazebo_driver_bringup)/config/sim_controllers.yaml</parameters>
      <ros>
        <namespace>/sim</namespace>
      </ros>
    </plugin>
  </gazebo>
</robot>
